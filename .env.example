# Copy to backend/.env and frontend/.env.local as needed. This file documents
# every variable used across the stack for docker-compose and local dev.

# --- Backend (backend/.env) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pmsaas
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production-please
CORS_ORIGINS=["http://localhost:3000"]
ENV=development

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
